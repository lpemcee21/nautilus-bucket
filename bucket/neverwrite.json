      "Remove-Item \"$dir\\NeverWrite_${version}_Windows_x64_Setup.exe\" -Force",
      "Remove-Item \"$dir\\`$PLUGINSDIR\" -Recurse -Force"
    ]
  },
  "bin": "NeverWrite.exe",
  "shortcuts": [
    [
      "NeverWrite.exe",
      "NeverWrite"
    ]
  ],
  "checkver": {
    "github": "jsgrrchg/NeverWrite",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/jsgrrchg/NeverWrite/releases/download/v$version/NeverWrite_${version}_Windows_x64_Setup.exe"
