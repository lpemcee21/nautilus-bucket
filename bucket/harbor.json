{
    "version": "1.0.3-beta",
    "description": "A custom Stremio client built for adventure",
    "homepage": "https://github.com/Harborofficial/Harbor",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Harborofficial/Harbor/releases/download/v1.0.3-beta/harbor-shipyard-v1.0.3-beta.exe#/harbor-shipyard.exe",
            "hash": "5ac450a80db6b64d62936296eb6ce75080bea94ddfffca33f5baa013d167779a"
        }
    },
    "installer": {
        "script": [
            "$fs = [System.IO.File]::OpenRead(\"$dir\\harbor-shipyard.exe\")",
            "try {",
            "    $tailLen = [Math]::Min(16777216L, $fs.Length)",
            "    $tailOffset = $fs.Length - $tailLen",
            "    $buf = New-Object byte[] $tailLen",
            "    $null = $fs.Seek($tailOffset, [System.IO.SeekOrigin]::Begin)",
            "    $read = 0; while ($read -lt $tailLen) { $n = $fs.Read($buf, $read, $tailLen - $read); if ($n -le 0) { break }; $read += $n }",
            "    $eocd = -1L; $zipStart = -1L",
            "    for ($i = $buf.Length - 22; $i -ge 0; $i--) {",
            "        if ($buf[$i] -eq 0x50 -and $buf[$i+1] -eq 0x4B -and $buf[$i+2] -eq 0x05 -and $buf[$i+3] -eq 0x06) {",
            "            $cdSize = [BitConverter]::ToUInt32($buf, $i + 12); $cdOffset = [BitConverter]::ToUInt32($buf, $i + 16)",
            "            $candEocd = $tailOffset + $i; $candStart = $candEocd - ($cdOffset + $cdSize)",
            "            if ($candStart -ge 0 -and $candStart -lt $candEocd) {",
            "                $hdr = New-Object byte[] 4; $null = $fs.Seek($candStart, [System.IO.SeekOrigin]::Begin); $null = $fs.Read($hdr, 0, 4)",
            "                if ($hdr[0] -eq 0x50 -and $hdr[1] -eq 0x4B -and $hdr[2] -eq 0x03 -and $hdr[3] -eq 0x04) { $eocd = $candEocd; $zipStart = $candStart; break }",
            "            }",
            "        }",
            "    }",
            "    if ($eocd -lt 0) { throw 'Could not locate embedded harbor-payload.zip inside harbor-shipyard.exe' }",
            "    $zipLen = ($eocd + 22) - $zipStart; $null = $fs.Seek($zipStart, [System.IO.SeekOrigin]::Begin)",
            "    $out = [System.IO.File]::Create(\"$dir\\harbor-payload.zip\")",
            "    try {",
            "        $chunk = New-Object byte[] 1048576; $rem = $zipLen",
            "        while ($rem -gt 0) { $n = $fs.Read($chunk, 0, [int][Math]::Min([long]$chunk.Length, $rem)); if ($n -le 0) { break }; $out.Write($chunk, 0, $n); $rem -= $n }",
            "    } finally { $out.Close() }",
            "} finally { $fs.Close() }",
            "Expand-7zipArchive \"$dir\\harbor-payload.zip\" \"$dir\"",
            "Remove-Item \"$dir\\harbor-shipyard.exe\", \"$dir\\harbor-payload.zip\", \"$dir\\uninstall.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "bin": "harbor.exe",
    "shortcuts": [
        [
            "harbor.exe",
            "Harbor"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Harborofficial/Harbor/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "/releases/download/v(?<tag>[^/]+)/(?<file>harbor-shipyard-v([\\d.]+(?:-beta)?)(?:-stable)?\\.exe)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Harborofficial/Harbor/releases/download/v$matchTag/$matchFile#/harbor-shipyard.exe"
            }
        }
    }
}
