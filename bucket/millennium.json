{
  "version": "3.3.1",
  "description": "An open-source low-code modding framework to create, manage, and use themes and plugins for the Steam desktop client.",
  "homepage": "https://steambrew.app/",
  "license": "MIT",
  "notes": [
    "Millennium integrates into Steam by placing wsock32.dll and the millennium directory inside your Steam installation folder.",
    "Please ensure Steam is completely closed before installing, updating, or uninstalling Millennium.",
    "Existing installs created before ownership tracking may require manual cleanup before updating; unmanaged Steam files are intentionally left untouched."
  ],
  "architecture": {
    "64bit": {
      "url": "https://github.com/SteamClientHomebrew/Millennium/releases/download/v3.3.1/millennium-v3.3.1-windows-x86_64.zip",
      "hash": "d05edc946841e775685c8e295d4c67d274d8ddeab5d739033228dd302391aa8a"
    }
  },
  "installer": {
    "script": [
      "if (Get-Process -Name 'steam' -ErrorAction SilentlyContinue) {",
      "    throw 'Steam is running. Exit Steam before installing or updating Millennium.'",
      "}",
      "$steamPath = $null",
      "if ($env:STEAM_PATH -and (Test-Path -LiteralPath $env:STEAM_PATH -PathType Container)) {",
      "    $steamPath = $env:STEAM_PATH",
      "}",
      "if (-not $steamPath -and (Test-Path 'HKCU:\\Software\\Valve\\Steam')) {",
      "    $regPath = (Get-ItemProperty -Path 'HKCU:\\Software\\Valve\\Steam' -Name 'SteamPath' -ErrorAction SilentlyContinue).SteamPath",
      "    if ($regPath -and (Test-Path -LiteralPath $regPath -PathType Container)) { $steamPath = $regPath.Replace('/', '\\') }",
      "}",
      "if (-not $steamPath -and (Test-Path 'HKLM:\\SOFTWARE\\WOW6432Node\\Valve\\Steam')) {",
      "    $regPath = (Get-ItemProperty -Path 'HKLM:\\SOFTWARE\\WOW6432Node\\Valve\\Steam' -Name 'InstallPath' -ErrorAction SilentlyContinue).InstallPath",
      "    if ($regPath -and (Test-Path -LiteralPath $regPath -PathType Container)) { $steamPath = $regPath.Replace('/', '\\') }",
      "}",
      "if (-not $steamPath) {",
      "    $scoopSteam = \"$env:USERPROFILE\\scoop\\apps\\steam\\current\"",
      "    if (Test-Path -LiteralPath $scoopSteam -PathType Container) { $steamPath = $scoopSteam }",
      "}",
      "if (-not $steamPath -and (Test-Path \"${env:ProgramFiles(x86)}\\Steam\" -PathType Container)) {",
      "    $steamPath = \"${env:ProgramFiles(x86)}\\Steam\"",
      "}",
      "if (-not $steamPath -and (Test-Path 'C:\\Steam' -PathType Container)) {",
      "    $steamPath = 'C:\\Steam'",
      "}",
      "if (-not $steamPath) {",
      "    throw 'Could not locate Steam installation path. Set $env:STEAM_PATH or install Steam.'",
      "}",
      "$steamPath = (Get-Item -LiteralPath $steamPath -ErrorAction Stop).FullName",
      "if (-not (Test-Path -LiteralPath (Join-Path $steamPath 'steam.exe') -PathType Leaf)) {",
      "    throw \"Steam executable not found under '$steamPath'. Refusing to modify this path.\"",
      "}",
      "$dllSource = Join-Path $dir 'wsock32.dll'",
      "$moduleSource = Join-Path $dir 'millennium'",
      "if (-not (Test-Path -LiteralPath $dllSource -PathType Leaf) -or -not (Test-Path -LiteralPath $moduleSource -PathType Container)) {",
      "    throw 'Millennium archive is missing wsock32.dll or the millennium directory.'",
      "}",
      "New-Item -ItemType Directory -Path $persist_dir -Force | Out-Null",
      "$statePath = Join-Path $persist_dir 'millennium-scoop-state.json'",
      "$dllTarget = Join-Path $steamPath 'wsock32.dll'",
      "$moduleTarget = Join-Path $steamPath 'millennium'",
      "$markerPath = Join-Path $moduleTarget '.nautilus-scoop-millennium'",
      "$state = $null",
      "if (Test-Path -LiteralPath $statePath -PathType Leaf) { $state = Get-Content -LiteralPath $statePath -Raw | ConvertFrom-Json }",
      "if (Test-Path -LiteralPath $dllTarget -PathType Leaf) {",
      "    if (-not $state -or $state.SteamPath -ne $steamPath) { throw 'Refusing to overwrite an unmanaged Steam wsock32.dll.' }",
      "    $currentHash = (Get-FileHash -LiteralPath $dllTarget -Algorithm SHA256).Hash",
      "    if ($currentHash -ne $state.Wsock32Hash) { throw 'Steam wsock32.dll changed outside Scoop; refusing to overwrite it.' }",
      "}",
      "if (Test-Path -LiteralPath $moduleTarget -PathType Container) {",
      "    if (-not (Test-Path -LiteralPath $markerPath -PathType Leaf)) { throw 'Refusing to overwrite an unmanaged Steam millennium directory.' }",
      "    if (-not $state -or -not $state.ModuleFiles) { throw 'Millennium ownership inventory is missing; refusing to overwrite the module directory.' }",
      "    foreach ($entry in @($state.ModuleFiles)) {",
      "        $moduleFile = Join-Path $moduleTarget $entry.Path",
      "        if ((Test-Path -LiteralPath $moduleFile -PathType Leaf) -and ((Get-FileHash -LiteralPath $moduleFile -Algorithm SHA256).Hash -ne $entry.Hash)) { throw \"Millennium file '$($entry.Path)' changed outside Scoop; refusing to overwrite it.\" }",
      "    }",
      "}",
      "if (Test-Path -LiteralPath $dllTarget -PathType Leaf) { Remove-Item -LiteralPath $dllTarget -Force }",
      "Copy-Item -LiteralPath $dllSource -Destination $dllTarget -Force",
      "Copy-Item -LiteralPath $moduleSource -Destination $moduleTarget -Recurse -Force",
      "Set-Content -LiteralPath $markerPath -Value \"Managed by nautilus-bucket Millennium $version\" -NoNewline",
      "$moduleFiles = @(Get-ChildItem -LiteralPath $moduleTarget -File -Recurse -Force | Where-Object { $_.FullName -ne $markerPath } | ForEach-Object { [ordered]@{ Path = $_.FullName.Substring($moduleTarget.Length + 1); Hash = (Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash } })",
      "$state = [ordered]@{ SteamPath = $steamPath; Wsock32Hash = (Get-FileHash -LiteralPath $dllTarget -Algorithm SHA256).Hash; ModuleFiles = $moduleFiles; Version = $version }",
      "$state | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $statePath -Encoding UTF8"
    ]
  },
  "uninstaller": {
    "script": [
      "if (Get-Process -Name 'steam' -ErrorAction SilentlyContinue) {",
      "    throw 'Steam is running. Exit Steam before uninstalling Millennium.'",
      "}",
      "$statePath = Join-Path $persist_dir 'millennium-scoop-state.json'",
      "if (-not (Test-Path -LiteralPath $statePath -PathType Leaf)) {",
      "    Write-Warning 'Millennium ownership state is missing; leaving Steam files untouched.'",
      "    return",
      "}",
      "$state = Get-Content -LiteralPath $statePath -Raw | ConvertFrom-Json",
      "$steamPath = [string]$state.SteamPath",
      "if (-not $steamPath -or -not (Test-Path -LiteralPath $steamPath -PathType Container)) {",
      "    Remove-Item -LiteralPath $statePath -Force",
      "    return",
      "}",
      "if (-not (Test-Path -LiteralPath (Join-Path $steamPath 'steam.exe') -PathType Leaf)) { throw \"Steam executable not found under '$steamPath'; refusing to remove files.\" }",
      "$dllTarget = Join-Path $steamPath 'wsock32.dll'",
      "$moduleTarget = Join-Path $steamPath 'millennium'",
      "$markerPath = Join-Path $moduleTarget '.nautilus-scoop-millennium'",
      "if (Test-Path -LiteralPath $dllTarget -PathType Leaf) {",
      "    $currentHash = (Get-FileHash -LiteralPath $dllTarget -Algorithm SHA256).Hash",
      "    if ($currentHash -ne $state.Wsock32Hash) { throw 'Steam wsock32.dll changed after installation; refusing to remove it.' }",
      "    Remove-Item -LiteralPath $dllTarget -Force",
      "}",
      "if (Test-Path -LiteralPath $moduleTarget -PathType Container) {",
      "    if (-not (Test-Path -LiteralPath $markerPath -PathType Leaf)) { throw 'Steam millennium directory is not owned by this manifest; refusing to remove it.' }",
      "    if (-not $state.ModuleFiles) { throw 'Millennium ownership inventory is missing; refusing to remove the module directory.' }",
      "    foreach ($entry in @($state.ModuleFiles)) {",
      "        $moduleFile = Join-Path $moduleTarget $entry.Path",
      "        if (Test-Path -LiteralPath $moduleFile -PathType Leaf) {",
      "            if ((Get-FileHash -LiteralPath $moduleFile -Algorithm SHA256).Hash -eq $entry.Hash) { Remove-Item -LiteralPath $moduleFile -Force } else { Write-Warning \"Preserving changed Millennium file '$($entry.Path)'.\" }",
      "        }",
      "    }",
      "    Remove-Item -LiteralPath $markerPath -Force",
      "    Get-ChildItem -LiteralPath $moduleTarget -Directory -Recurse -Force | Sort-Object { $_.FullName.Length } -Descending | ForEach-Object { if ((Get-ChildItem -LiteralPath $_.FullName -Force).Count -eq 0) { Remove-Item -LiteralPath $_.FullName -Force } }",
      "    if ((Get-ChildItem -LiteralPath $moduleTarget -Force).Count -eq 0) { Remove-Item -LiteralPath $moduleTarget -Force }",
      "}",
      "Remove-Item -LiteralPath $statePath -Force"
    ]
  },
  "checkver": {
    "github": "SteamClientHomebrew/Millennium",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/SteamClientHomebrew/Millennium/releases/download/v$version/millennium-v$version-windows-x86_64.zip"
      }
    }
  }
}
